# Optional. Enables live multimodal extraction of uploaded challan and vehicle
# records. The guided synthetic demo, the deterministic comparison rules and the
# whole of Scam Shield work without this file.
#
# Copy to .env.local and never commit the copy.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.6-terra, which balances extraction
# accuracy against cost for image and PDF field reading. Set gpt-5.6-sol when
# maximum accuracy on poor-quality scans matters more than cost.
OPENAI_MODEL=gpt-5.6-terra
